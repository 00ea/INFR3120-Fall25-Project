<div class="container">
  <!-- This lets us mark a book as borrowed, essential for keeping track -->
  <div class="text-center mt-4 mb-3">
    <h2>Lend Book: <%= book.title %></h2>
    <h5>Author: <%= book.author %></h5>
  </div>
  <div class="row justify-content-center">
    <div class="col-md-6">
      <!-- The main lending form. All fields are required to help with book tracking. -->
      <form action="/lend/<%= book.id %>" method="POST" class="card shadow p-4 border-0">
        <div class="mb-3">
          <label for="borrower" class="form-label font-weight-bold">
            Borrower (email)
          </label>
          <input type="email" class="form-control" id="borrower" name="borrower" required placeholder="Borrower's email">
        </div>
        <div class="mb-3">
          <label for="due" class="form-label font-weight-bold">Expected Return Date</label>
          <input type="date" class="form-control" id="due" name="due" required>
        </div>
        <button type="submit" class="btn btn-warning btn-block">Lend Book</button>
      </form>
    </div>
  </div>
</div>
