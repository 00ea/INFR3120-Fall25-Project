<div class="container">
  <div class="row justify-content-center my-4">
    <div class="col-lg-7">
      <div class="card">
        <div class="card-body p-4">
          <h1 class="card-title text-center mb-4">
            <i class="fa-solid fa-plus-circle"></i> Add New Book
          </h1>

          <form action="/add" method="POST">
            <div class="row">
              <div class="col-md-6">
                <div class="form-group">
                  <label for="bookTitle">
                    <i class="fa-solid fa-book"></i> Book Title
                  </label>
                  <input type="text" id="bookTitle" name="title" class="form-control" placeholder="e.g. The Catcher in the Rye" required>
                </div>
              </div>
              
              <div class="col-md-6">
                <div class="form-group">
                  <label for="bookAuthor">
                    <i class="fa-solid fa-user-pen"></i> Author
                  </label>
                  <input type="text" id="bookAuthor" name="author" class="form-control" placeholder="e.g. J.D. Salinger" required>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="form-group">
                  <label for="bookGenre">
                    <i class="fa-solid fa-tags"></i> Genre
                  </label>
                  <input type="text" id="bookGenre" name="genre" class="form-control" placeholder="e.g. Fiction">
                </div>
              </div>
              
              <div class="col-md-6">
                <div class="form-group">
                  <label for="borrowerName">
                    <i class="fa-solid fa-user"></i> Borrower Name
                  </label>
                  <input type="text" id="borrowerName" name="borrower" class="form-control" placeholder="e.g. Jane Doe">
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="form-group">
                  <label for="borrowerEmail">
                    <i class="fa-solid fa-envelope"></i> Borrower Email
                  </label>
                  <input type="email" id="borrowerEmail" name="borrowerEmail" class="form-control" placeholder="e.g. janedoe@email.com">
                </div>
              </div>
              
              <div class="col-md-6">
                <div class="form-group">
                  <label for="returnDate">
                    <i class="fa-solid fa-calendar"></i> Expected Return Date
                  </label>
                  <input type="date" id="returnDate" name="due" class="form-control">
                </div>
              </div>
            </div>

            <div class="form-group">
              <label for="notes">
                <i class="fa-solid fa-note-sticky"></i> Notes
              </label>
              <textarea class="form-control" id="notes" name="notes" rows="3" placeholder="Additional notes about this book..."></textarea>
            </div>

            <div class="d-flex gap-2 justify-content-center pt-3">
              <button type="submit" class="btn btn-primary btn-lg">
                <i class="fa-solid fa-save"></i> Save Book
              </button>
              <a href="/" class="btn btn-secondary btn-lg">
                <i class="fa-solid fa-times"></i> Cancel
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
