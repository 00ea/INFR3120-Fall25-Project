<div class="container">
  <div class="text-center mt-4 mb-5">
    <h2 class="card-title">Add a Book</h2>
    <p class="lead">Fill in the details below to add a new book to your collection.</p>
  </div>
  <div class="row justify-content-center">
    <div class="col-md-6">
      <form action="/add" method="POST" class="card shadow p-4 border-0">
        <div class="mb-3">
          <label for="title" class="form-label font-weight-bold">Title</label>
          <input type="text" class="form-control" id="title" name="title" required placeholder="Title of the book">
        </div>
        <div class="mb-3">
          <label for="author" class="form-label font-weight-bold">Author</label>
          <input type="text" class="form-control" id="author" name="author" required placeholder="Book's author">
        </div>
        <button type="submit" class="btn btn-success btn-block">Add Book</button>
      </form>
    </div>
  </div>
</div>
