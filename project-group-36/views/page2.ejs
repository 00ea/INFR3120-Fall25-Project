<%- contentFor('body') %>

<div class="d-flex justify-content-center">
  <div class="card bg-secondary p-4" style="max-width: 52rem; width: 100%;">
    <div class="card-body d-flex flex-column align-items-center p-4">

      <!-- Title -->
      <h1 class="card-title py-3" style="text-align: center; font-size: 2.25rem;">
        Add New Book <i class="fa-solid fa-book"></i>
      </h1>


      <form class="row w-100 gx-5 gy-3" action="/add" method="POST">
        <!-- Book Title -->
        <div class="col-md-6 pt-3">
          <label for="bookTitle" class="form-label">
            Book Title <i class="fa-solid fa-heading"></i>
          </label>
          <input type="text" id="bookTitle" name="title" class="form-control" placeholder="e.g. The Catcher in the Rye" required>
        </div>
        <!-- Author -->
        <div class="col-md-6 pt-3">
          <label for="bookAuthor" class="form-label">
            Author <i class="fa-solid fa-user-pen"></i>
          </label>
          <input type="text" id="bookAuthor" name="author" class="form-control" placeholder="e.g. J.D. Salinger" required>
        </div>
        <!-- Genre -->
        <div class="col-12 pt-3" style="text-align: center;">
          <label for="bookGenre" class="form-label">
            Genre <i class="fa-solid fa-tags"></i>
          </label>
          <input type="text" style="max-width: 300px;" id="bookGenre" name="genre" class="form-control mx-auto" placeholder="e.g. Fiction">
        </div>
        
        <!-- Notes Section -->
        <div class="col-12 pt-3" style="text-align: center;">
          <label for="notes" class="form-label">
            Notes <i class="fa-solid fa-note-sticky"></i>
          </label>
          <textarea class="form-control mx-auto" id="notes" name="notes" rows="4" style="max-width: 70%;" placeholder="Additional notes about this book"></textarea>
        </div>
        <!-- Submit Button -->
        <div class="pt-4 col-12" style="text-align: center;">
          <button type="submit" class="btn btn-outline-dark btn-lg px-5">Save Book</button>
        </div>
      </form>
      <!-- End form here -->

    </div>
  </div>
</div>
