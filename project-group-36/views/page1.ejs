<div class="container">
  <!-- hero section with title and logo -->
  <div class="hero-section">
    <h1>📚 Library Link</h1>
    <h5>Browse your collection, lend books, and organize your reading group!</h5>
    <img src="/images/logo.png" alt="Group 36 Logo" class="rounded-circle">
  </div>

  <!-- book catalog section -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <h3 class="card-title mb-3">
            <i class="fa-solid fa-list"></i> Book Catalog
          </h3>
          
          <!-- show message if no books -->
          <% if (books.length === 0) { %>
            <p class="text-muted text-center py-4">
              <i class="fa-solid fa-inbox" style="font-size: 2rem; color: var(--border-color); margin-bottom: 1rem;"></i>
              <br>No books yet. <a href="/add">Add your first book</a>!
            </p>
          <% } else { %>
            <!-- display books in table -->
            <div class="table-responsive">
              <table class="table table-hover">
                <thead class="thead-dark">
                  <tr>
                    <th><i class="fa-solid fa-book"></i> Title</th>
                    <th><i class="fa-solid fa-user-edit"></i> Author</th>
                    <th><i class="fa-solid fa-info-circle"></i> Status</th>
                    <th style="width: 150px;"><i class="fa-solid fa-cogs"></i> Action</th>
                  </tr>
                </thead>
                <tbody>
                  <!-- loop through each book -->
                  <% books.forEach(function(book) { %>
                    <tr>
                      <td><strong><%= book.title %></strong></td>
                      <td><%= book.author %></td>
                      <td>
                        <!-- show if book is borrowed or available -->
                        <% if (book.borrower) { %>
                          <span class="badge badge-warning">
                            <i class="fa-solid fa-hand-holding-heart"></i>
                            Lent to <%= book.borrower %>
                          </span>
                          <br>
                          <small class="text-muted">Due: <%= book.due %></small>
                        <% } else { %>
                          <span class="badge badge-success">
                            <i class="fa-solid fa-check-circle"></i>
                            Available
                          </span>
                        <% } %>
                      </td>
                      <!-- lend or return button -->
                      <td>
                        <% if (!book.borrower) { %>
                          <a href="/lend/<%= book.id %>" class="btn btn-sm btn-success" title="Lend this book">
                            <i class="fa-solid fa-hand-holding"></i>
                          </a>
                        <% } else { %>
                          <form action="/return/<%= book.id %>" method="POST" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-warning" title="Return this book">
                              <i class="fa-solid fa-undo"></i>
                            </button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- only show add/remove buttons if logged in -->
  <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
    <div class="row">
      <div class="col-md-6 offset-md-3">
        <div class="d-flex gap-2 justify-content-center">
          <a href="/add" class="btn btn-primary btn-lg">
            <i class="fa-solid fa-plus"></i> Add Book
          </a>
          <a href="/remove" class="btn btn-danger btn-lg">
            <i class="fa-solid fa-trash"></i> Remove Book
          </a>
        </div>
      </div>
    </div>
  <% } %>
</div>
