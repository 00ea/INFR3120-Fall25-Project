<div class="container">
  <!-- login form card -->
  <div class="row justify-content-center my-5">
    <div class="col-md-5">
      <div class="card">
        <div class="card-body p-5">
          <!-- header -->
          <div class="text-center mb-4">
            <i class="fa-solid fa-sign-in-alt" style="font-size: 2.5rem; color: var(--secondary-color);"></i>
            <h2 class="card-title mt-3">Welcome Back</h2>
            <p class="text-muted">Sign in to your Library Link account</p>
          </div>
          
          <!-- show error if login failed -->
          <% if (error) { %>
            <div class="alert alert-danger" role="alert">
              <i class="fa-solid fa-exclamation-circle"></i> <%= error %>
            </div>
          <% } %>
          
          <!-- login form -->
          <form method="POST" action="/auth/login">
            <!-- email input -->
            <div class="form-group">
              <label for="email">
                <i class="fa-solid fa-envelope"></i> Email Address
              </label>
              <input type="email" class="form-control" id="email" name="email" placeholder="your@email.com" required>
            </div>
            
            <!-- password input -->
            <div class="form-group">
              <label for="password">
                <i class="fa-solid fa-lock"></i> Password
              </label>
              <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required>
            </div>
            
            <button type="submit" class="btn btn-primary btn-block btn-lg">
              <i class="fa-solid fa-sign-in-alt"></i> Login
            </button>
          </form>
          
          <hr class="my-4">
          
          <!-- link to register -->
          <p class="text-center mb-0">
            Don't have an account? 
            <a href="/auth/register" style="font-weight: 600;">Register here</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
