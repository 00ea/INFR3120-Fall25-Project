<div class="container">
  <!-- Page 4: Contact form or feedback -->
  <div class="row justify-content-center">
    <div class="col-md-7">
      <div class="card mt-4 mb-4 shadow">
        <div class="card-header bg-dark text-white text-center">
          <h3>Contact Us <i class="fa-solid fa-envelope"></i></h3>
        </div>
        <div class="card-body">
          <form action="/success" method="GET">
            <!-- Name field  -->
            <div class="form-group">
              <label for="inputName">Name <i class="fa-solid fa-id-card"></i></label>
              <input type="text" class="form-control" id="inputName" name="name" placeholder="Your Name" required>
            </div>
            <!-- Email field for responses -->
            <div class="form-group">
              <label for="inputEmail">Email <i class="fa-solid fa-envelope"></i></label>
              <input type="email" class="form-control" id="inputEmail" name="email" placeholder="your@email.com" required>
            </div>
            <div class="form-group">
              <label for="inputPhone">Phone Number <i class="fa-solid fa-phone"></i></label>
              <input type="tel" class="form-control" id="inputPhone" name="phone" placeholder="(123)-456-7890">
            </div>
            <!-- Message area for user's actual content -->
            <div class="form-group">
              <label for="messageField">Message <i class="fa-solid fa-comment-dots"></i></label>
              <textarea class="form-control" id="messageField" name="message" rows="4" placeholder="Write your message here..." required></textarea>
            </div>
            <button type="submit" class="btn btn-outline-dark btn-block mt-3">Send Message</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
