<%- contentFor('body') %>

<div class="d-flex justify-content-center">
  <div class="card bg-secondary p-4" style="max-width: 52rem; width: 100%;">
    <div class="card-body d-flex flex-column align-items-center p-4">

      <!-- Page Title -->
      <h1 class="card-title py-3" style="text-align: center; font-size: 2.25rem;">
        Remove Book <i class="fa-solid fa-trash"></i>
      </h1>
      <p class="mb-4 text-center" style="font-size: 1.1rem;">
        Select a book to remove from your catalog.
      </p>

      <!-- Table -->
      <div class="table-responsive w-100">
        <table class="table table-bordered">
          <thead class="thead-dark">
            <tr>
              <th>Title</th>
              <th>Author</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% books.forEach(function(book) { %>
              <tr>
                <td><%= book.title %></td>
                <td><%= book.author %></td>
                <td>
                  <form action="/delete/<%= book.id %>" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to remove this book?')">
                      Remove
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Back Button -->
      <div class="text-right pt-3 w-100" style="text-align: right;">
        <a href="/" class="btn btn-outline-dark">Back to Catalog</a>
      </div>

    </div>
  </div>
</div>
