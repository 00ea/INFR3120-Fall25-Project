<%- contentFor('body') %>
<div class="container">
  <div class="text-center mt-4 mb-5">
    <h2 class="mb-4">Remove Book</h2>
    <p>Select a book to remove from your catalog.</p>
  </div>
  <div class="table-responsive">
    <table class="table table-bordered table-hover">
      <thead class="thead-dark">
        <tr>
          <th>Title</th>
          <th>Author</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% books.forEach(function(book) { %>
          <tr>
            <td><%= book.title %></td>
            <td><%= book.author %></td>
            <td>
              <form action="/delete/<%= book.id %>" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to remove this book?')">Remove</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="text-right mb-3">
    <a href="/" class="btn btn-secondary">Back to Catalog</a>
  </div>
</div>
